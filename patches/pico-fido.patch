+
+// Pass Key: its management page sends the FIDO PIN over the board's serial port to list and delete
+// passkeys. The same checks and retry counting as getPinUvAuthToken, without the key agreement;
+// on success the device key is unlocked as after a PIN entered in a browser.
+int fido_pin_check(const uint8_t *pin, size_t pin_len, uint8_t *retries_left) {
+    *retries_left = 0;
+    if (!file_has_data(ef_pin)) {
+        return CTAP2_ERR_PIN_NOT_SET;
+    }
+    uint8_t pin_data[PIN_DATA_LEN];
+    uint16_t pin_data_len = 0;
+    if (!load_pin_data(ef_pin, pin_data, &pin_data_len)) {
+        return CTAP2_ERR_PROCESSING;
+    }
+    if ((pin_data[0] & PIN_RETRY_COUNT_MASK) == 0) {
+        return CTAP2_ERR_PIN_BLOCKED;
+    }
+    pin_data[0] = (uint8_t)((pin_data[0] & PIN_RETRY_POWER_CYCLE) | ((pin_data[0] & PIN_RETRY_COUNT_MASK) - 1));
+    if (!persist_pin_retry_counter(ef_pin, pin_data, pin_data_len)) {
+        return CTAP2_ERR_PROCESSING;
+    }
+    uint8_t retries = pin_data[0] & PIN_RETRY_COUNT_MASK;
+    bool power_cycle_locked = (pin_data[0] & PIN_RETRY_POWER_CYCLE) != 0;
+    uint8_t pin_hash[32], dhash[32], off = 3;
+    mbedtls_sha256(pin, pin_len, pin_hash, 0);   // the browser sends LEFT(SHA-256(PIN), 16)
+    if (pin_data_len == PIN_LEGACY_DATA_LEN) {
+        off = 2;
+        double_hash_pin(CONST_BYTE_ARRAY(pin_hash, 16), dhash);
+    }
+    else {
+        pin_derive_verifier(CONST_BYTE_ARRAY(pin_hash, 16), dhash);
+    }
+    if (mbedtls_ct_memcmp(dhash, pin_data + off, 32) != 0) {
+        mbedtls_platform_zeroize(pin_hash, sizeof(pin_hash));
+        mbedtls_platform_zeroize(dhash, sizeof(dhash));
+        *retries_left = retries;
+        if (retries == 0) {
+            return CTAP2_ERR_PIN_BLOCKED;
+        }
+        if (power_cycle_locked || ++new_pin_mismatches >= 3) {
+            if (!power_cycle_locked) {
+                pin_data[0] |= PIN_RETRY_POWER_CYCLE;
+                persist_pin_retry_counter(ef_pin, pin_data, pin_data_len);
+            }
+            needs_power_cycle = true;
+            return CTAP2_ERR_PIN_AUTH_BLOCKED;
+        }
+        return CTAP2_ERR_PIN_INVALID;
+    }
+    mbedtls_platform_zeroize(dhash, sizeof(dhash));
+    if (needs_power_cycle) {
+        mbedtls_platform_zeroize(pin_hash, sizeof(pin_hash));
+        return CTAP2_ERR_PIN_AUTH_BLOCKED;
+    }
+    if (off == 2) {   // a PIN from before pico-fido's current format: let a browser upgrade it
+        mbedtls_platform_zeroize(pin_hash, sizeof(pin_hash));
+        return CTAP2_ERR_PROCESSING;
+    }
+    pin_derive_session(CONST_BYTE_ARRAY(pin_hash, 16), session_pin);
+    mbedtls_platform_zeroize(pin_hash, sizeof(pin_hash));
+    int ret = check_keydev_encrypted(session_pin);
+    if (ret != PICOKEYS_OK) {
+        return ret;
+    }
+    pin_data[0] = MAX_PIN_RETRIES;
+    new_pin_mismatches = 0;
+    file_put_data(ef_pin, CONST_BYTE_ARRAY(pin_data, sizeof(pin_data)));
+    mbedtls_platform_zeroize(pin_data, sizeof(pin_data));
+    flash_commit();
+    *retries_left = MAX_PIN_RETRIES;
+    return 0;
+}
